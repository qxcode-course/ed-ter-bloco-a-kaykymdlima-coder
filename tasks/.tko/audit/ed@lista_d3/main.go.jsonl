{"ts":1783283607,"hash":"e9f8c16302614f1cf63fccacbae36824fb8ad55e90a6911b702dff68c8ac0221","mode":"diff","ops":[{"tag":"insert","a1":76,"a2":76,"text":"func merge (lla, llb *LList) *LList {\n\tnua := lla.root.next\n\tnub := llb.root.next\n\n\tfor nub != llb.root {\n\t\tif nua != lla.root && nua.Value <= nub.Value {\n\t\t\tnua = nua.next\n\t} else {\n\t\tllb.insertBefore(nua, nub.Value)\n\t\tnub = nub.next\n\t}\n}\n"}]}
