{"ts":1783281939,"hash":"5f6621ab7c3dba7924d586cb8f0ddf09560a04fa5b922d4e4da527e7661dc468","mode":"diff","ops":[{"tag":"insert","a1":59,"a2":59,"text":"func addsorted(l *LList, value int) {\n\tn := l.root.next\n\tfor n != l.root && n.Value < value {\n\t\tn = n.next\n\t}\n\tl.insertBefore(n, value)\n}\n\n"},{"tag":"replace","a1":99,"a2":105,"text":"\t\t\tlla := NewLList()\n\t\t\tfor i := 1; i < len(args); i++ {\n\t\t\t\tvalue, _ := strconv.Atoi(args[i])\n\t\t\t\taddsorted(lla, value)\n\t\t\t}\n\t\t\tfmt.Println(lla)\n"}]}
