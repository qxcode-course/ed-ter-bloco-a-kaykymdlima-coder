{"ts":1783282990,"hash":"2af30746a922d3d4dd9aa76e4c6c88b4eb970183eb7cfd0854f1f5c5f543d957","mode":"diff","ops":[{"tag":"replace","a1":66,"a2":67,"text":"func reverse(l *LList) {\n\tatual := l.root\n\tfor {\n\t\tatual.next, atual.prev = atual.prev, atual.next\n\t\tatual = atual.prev\n\t\tif atual == l.root {\n\t\t\tbreak\n\t\t}\n\t}\n}\n"}]}
{"ts":1783283289,"hash":"cf23a12685945cb9bff5592747e662434c9dd1310fd66270c4b19b3c318e666d","mode":"diff","ops":[{"tag":"insert","a1":88,"a2":88,"text":"func (l *LList) String() string {\n\tvaluel := []string{}\n\n\tfor n := l.root.next; n != l.root; n = n.next {\n\t\tvaluel = append(valuel, strconv.Itoa(n.Value))\n\t}\n\treturn \"[\" + strings.Join(valuel, \",\") + \"]\"\n}\n"}]}
