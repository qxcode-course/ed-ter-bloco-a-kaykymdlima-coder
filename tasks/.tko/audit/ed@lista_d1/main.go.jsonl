{"ts":1783212152,"hash":"1092f6570e2a67ade4abd4d8cdb36e9c11e5ed332b18dd898a3885af7eb6f7ed","mode":"diff","ops":[{"tag":"insert","a1":13,"a2":13,"text":"}\n\ntype LList struct {\n\troot *Node\n}\n\nfunc NewLList() *LList {\n\troot := &Node{}\n\troot.next = root\n\troot.prev = root\n\treturn &LList{root: root}\n"}]}
{"ts":1783212400,"hash":"fae66df298a7d14271c1523ee0dde402ad440dde6ba7393e055f56000ca460d5","mode":"diff","ops":[{"tag":"insert","a1":6,"a2":6,"text":"\t\"strconv\"\n"},{"tag":"insert","a1":17,"a2":17,"text":"}\n\nfunc (ll *LList) String() string {\n\tvar sb strings.Builder\n\tsb.WriteString(\"[\")\n\n\tnode := ll.root.next\n\tfor node != ll.root {\n\t\tsb.WriteString(strconv.Itoa(node.value))\n\t\tif node.next != ll.root {\n\t\t\tsb.Write()\n\t\t}\n\t}\n"}]}
